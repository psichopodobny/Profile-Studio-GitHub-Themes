{
  "manifest_version": 3,
  "name": "psichopodobny / Winter Profile",
  "version": "1.0.0",
  "description": "Зимнее оформление профиля psichopodobny и общей страницы с uikole.",
  "permissions": ["storage"],
  "icons": {"16": "media/icon-16.png", "48": "media/icon-48.png", "128": "media/icon-128.png"},
  "action": {"default_title": "Winter Profile", "default_popup": "popup.html"},
  "content_scripts": [{
    "matches": ["https://github.com/psichopodobny", "https://github.com/psichopodobny/*", "https://github.com/psichopodobny?*"],
    "js": ["scope.js", "view.js", "controller.js", "content.js"],
    "css": ["host.css"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["theme.css", "media/arima-tie.png", "media/profile-avatar.png", "media/winter-forest.png", "media/winter-lake.png", "media/k-on-original.jpg"],
    "matches": ["https://github.com/*"]
  }]
}
