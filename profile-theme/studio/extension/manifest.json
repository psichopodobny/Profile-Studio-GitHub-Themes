{
  "manifest_version": 3,
  "name": "Profile Studio - GitHub Themes",
  "version": "1.5.4",
  "options_ui": {
    "page": "studio.html",
    "open_in_tab": true
  },
  "description": "Создавай и публикуй оформление GitHub, смотри темы владельцев профилей и переделывай темы сообщества под себя.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "media/icon-16.png",
    "48": "media/icon-48.png",
    "128": "media/icon-128.png"
  },
  "action": {
    "default_title": "Profile Studio",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "media/icon-16.png",
      "48": "media/icon-48.png",
      "128": "media/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "options.js",
        "branding.js",
        "scope.js",
        "backgrounds.js",
        "avatars.js",
        "frame-catalog.js",
        "frame-media.js",
        "frame-settings.js",
        "frame-designs.js",
        "frames.js",
        "cursor.js",
        "components.js",
        "weather.js",
        "scene.js",
        "effects.js",
        "view.js",
        "controller.js",
        "content.js"
      ],
      "css": [
        "native.css",
        "scene.css",
        "effects.css",
        "components.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "media/winter-forest.png",
        "media/winter-forest-wide.webp",
        "media/winter-lake.png",
        "media/avatar.svg",
        "media/fonts/*.ttf",
        "media/frames/*.png"
      ],
      "matches": [
        "https://github.com/*"
      ]
    }
  ]
}
